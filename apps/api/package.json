{
  "name": "@athosbet/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:integration": "jest --runInBand test/integration",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js",
    "backtest": "node dist/odds/backtest.cli.js"
  },
  "dependencies": {
    "@athosbet/odds-engine": "workspace:*",
    "@athosbet/shared": "workspace:*",
    "@nestjs/common": "11.0.5",
    "@nestjs/core": "11.0.5",
    "@nestjs/platform-express": "11.0.5",
    "@nestjs/platform-socket.io": "11.0.5",
    "@nestjs/swagger": "11.0.3",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/websockets": "11.0.5",
    "bullmq": "5.34.10",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.38.3",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@swc/core": "1.10.7",
    "@swc/jest": "0.2.37",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "typescript": "5.7.3",
    "@nestjs/testing": "11.0.5"
  }
}
